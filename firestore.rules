rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admin/config)
        && request.auth.uid in get(/databases/$(database)/documents/admin/config).data.authorizedUids;
    }

    function ownsTicket(ticketId) {
      return signedIn()
        && get(/databases/$(database)/documents/support/$(ticketId)).data.userId == request.auth.uid;
    }

    match /admin/{doc} {
      allow read, write: if false;
    }

    match /updates/{updateId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /support/{ticketId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 200
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 5000;
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if ownsTicket(ticketId) || isAdmin();
        allow create: if isAdmin()
          || (ownsTicket(ticketId)
              && request.resource.data.senderId == request.auth.uid
              && request.resource.data.senderRole == 'user'
              && request.resource.data.text is string
              && request.resource.data.text.size() <= 2000);
        allow update, delete: if isAdmin();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
