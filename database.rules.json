{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      ".indexOn": ["username"],
      ".read": "auth != null",
      "$uid": {
        ".write": false
      }
    },

    "seasons": {
      "$seasonId": {
        ".indexOn": ["sp"],
        ".read": "auth != null",
        "$uid": {
          ".write": false
        }
      }
    },

    "guard": {
      ".read": false,
      ".write": false
    },

    "adminLogs": {
      ".read": false,
      ".write": false
    }
  }
}